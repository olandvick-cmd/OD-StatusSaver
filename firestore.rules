rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedOwner() {
      return isEmailVerified() && (
        request.auth.token.email == 'Olandvick@gmail.com' ||
        request.auth.token.email == 'olandvick@gmail.com'
      );
    }

    function isAdminRecordExists(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid));
    }

    function getAdminRecord(uid) {
      return get(/databases/$(database)/documents/admins/$(uid)).data;
    }

    function isOwner() {
      return isBootstrappedOwner() || (
        isSignedIn() &&
        isAdminRecordExists(request.auth.uid) &&
        getAdminRecord(request.auth.uid).role == 'owner'
      );
    }

    function isAdmin() {
      return isOwner() || (
        isSignedIn() &&
        isAdminRecordExists(request.auth.uid) &&
        getAdminRecord(request.auth.uid).role == 'administrator'
      );
    }

    function isAnalyst() {
      return isAdmin() || (
        isSignedIn() &&
        isAdminRecordExists(request.auth.uid) &&
        getAdminRecord(request.auth.uid).role == 'analyst'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection probe
    match /test/{testId} {
      allow read: if true;
    }

    // Admins Collection: Controls access to the dashboard
    match /admins/{adminId} {
      // Any authenticated user can read their own admin doc, or any analyst/admin/owner can view the team list
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAnalyst());
      allow list: if isAnalyst();

      // Bootstrapped owner can create their own initial document
      allow create: if isValidId(adminId) && isBootstrappedOwner() && request.auth.uid == adminId && request.resource.data.role == 'owner' && request.resource.data.email is string && request.resource.data.email.size() <= 256;

      allow update: if false; // Role changes require a trusted Firebase Admin SDK workflow.

      // Only owner can delete admin documents (cannot delete self)
      allow delete: if isValidId(adminId) && isOwner() && request.auth.uid != adminId;
    }

    // App Configuration: Announcements, Maintenance mode, Feature flags, Ad settings
    match /app_config/{configId} {
      // Mobile app clients can read config (without login, since mobile users have no accounts)
      allow get: if isValidId(configId);
      allow list: if isAnalyst();

      // Only Owner and Administrators can update or create configuration
      allow create, update: if isValidId(configId) && isAdmin() &&
        request.resource.data.maintenanceMode is bool &&
        request.resource.data.announcementActive is bool &&
        request.resource.data.adBannerEnabled is bool;

      allow delete: if isValidId(configId) && isOwner();
    }

    // Audit Logs: Immutable log of administrative actions
    match /audit_logs/{logId} {
      allow get, list: if isAnalyst();

      // Any authenticated admin/analyst performing an action can append a log entry
      allow create: if isValidId(logId) && isAnalyst() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.action is string &&
        request.resource.data.action.size() <= 64 &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 1000;

      // Audit logs are strictly immutable: no updates or deletions allowed
      allow update, delete: if false;
    }

    // Daily Analytics Aggregates: Zero-PII aggregates (DAU, saves, WhatsApp selections)
    match /analytics_aggregates/{dateId} {
      allow get, list: if isAnalyst();
      allow create, update: if isValidId(dateId) && isAdmin() &&
        request.resource.data.date is string &&
        request.resource.data.dau is number;
      allow delete: if isValidId(dateId) && isOwner();
    }

    // Crash Reports: Sanitized crash summaries
    match /crash_reports/{reportId} {
      allow get, list: if isAnalyst();
      allow create, update: if isValidId(reportId) && isAdmin();
      allow delete: if isValidId(reportId) && isOwner();
    }

    // AdMob Reports: Performance metrics & estimated earnings
    match /admob_reports/{reportId} {
      allow get, list: if isAnalyst();
      allow create, update: if isValidId(reportId) && isAdmin();
      allow delete: if isValidId(reportId) && isOwner();
    }

    // Validation helpers for Real-Time Telemetry & Alerting
    function isValidTelemetryEvent(data) {
      return data.keys().hasAll(['eventType', 'appVersion', 'androidVersion', 'source', 'details', 'createdAt']) &&
        data.keys().hasOnly(['eventType', 'appVersion', 'androidVersion', 'source', 'details', 'createdAt']) &&
        data.eventType in ['app_open', 'crash_reported'] &&
        data.appVersion is string && data.appVersion.size() > 0 && data.appVersion.size() <= 20 &&
        data.androidVersion is string && data.androidVersion.size() > 0 && data.androidVersion.size() <= 40 &&
        data.source is string && data.source.size() > 0 && data.source.size() <= 32 &&
        data.details is string && data.details.size() <= 300 &&
        data.createdAt is timestamp;
    }

    function isValidAlertRule(data) {
      return data.keys().hasAll([
          'appOpenThreshold', 'crashReportedThreshold', 'windowMinutes',
          'appOpenEnabled', 'crashReportedEnabled', 'soundEnabled',
          'updatedAt', 'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'appOpenThreshold', 'crashReportedThreshold', 'windowMinutes',
          'appOpenEnabled', 'crashReportedEnabled', 'soundEnabled',
          'updatedAt', 'updatedBy'
        ]) &&
        data.appOpenThreshold is number && data.appOpenThreshold >= 1 && data.appOpenThreshold <= 10000 &&
        data.crashReportedThreshold is number && data.crashReportedThreshold >= 1 && data.crashReportedThreshold <= 1000 &&
        data.windowMinutes is number && data.windowMinutes >= 1 && data.windowMinutes <= 1440 &&
        data.appOpenEnabled is bool &&
        data.crashReportedEnabled is bool &&
        data.soundEnabled is bool &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128;
    }

    function isValidAdminNotification(data) {
      return data.keys().hasAll([
          'eventType', 'severity', 'title', 'message',
          'eventCount', 'threshold', 'acknowledged', 'acknowledgedBy', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'eventType', 'severity', 'title', 'message',
          'eventCount', 'threshold', 'acknowledged', 'acknowledgedBy', 'createdAt'
        ]) &&
        data.eventType in ['app_open', 'crash_reported'] &&
        data.severity in ['info', 'warning', 'critical'] &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 400 &&
        data.eventCount is number && data.eventCount >= 1 && data.eventCount <= 100000 &&
        data.threshold is number && data.threshold >= 1 && data.threshold <= 100000 &&
        data.acknowledged is bool &&
        data.acknowledgedBy is string && data.acknowledgedBy.size() <= 128 &&
        data.createdAt is timestamp;
    }

    // Live Telemetry Events: Sanitized app_open & crash_reported stream
    match /telemetry_events/{eventId} {
      allow get, list: if isEmailVerified() && isAnalyst();
      allow create: if isValidId(eventId) && isEmailVerified() && isAdmin() &&
        isValidTelemetryEvent(request.resource.data) &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(eventId) && isEmailVerified() && isOwner();
    }

    // Alert Rules: Threshold configuration for real-time notifications
    match /alert_rules/{ruleId} {
      allow get, list: if isEmailVerified() && isAnalyst();
      allow create: if isValidId(ruleId) && isEmailVerified() && isAdmin() &&
        isValidAlertRule(request.resource.data) &&
        request.resource.data.updatedAt == request.time;
      allow update: if isValidId(ruleId) && isEmailVerified() && isAdmin() &&
        isValidAlertRule(request.resource.data) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isValidId(ruleId) && isEmailVerified() && isOwner();
    }

    // Admin Notifications: Persisted alerts triggered by telemetry thresholds
    match /admin_notifications/{notificationId} {
      allow get, list: if isEmailVerified() && isAnalyst();
      allow create: if isValidId(notificationId) && isEmailVerified() && isAnalyst() &&
        isValidAdminNotification(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.acknowledged == false &&
        request.resource.data.acknowledgedBy == '';
      allow update: if isValidId(notificationId) && isEmailVerified() && isAnalyst() &&
        isValidAdminNotification(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledgedBy']) &&
        request.resource.data.acknowledged == true &&
        request.resource.data.acknowledgedBy.size() > 0;
      allow delete: if isValidId(notificationId) && isEmailVerified() && isOwner();
    }
  }
}
